QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_URL=redis://localhost:6379/0
DATA_DIR=./data
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# JSON 数组字符串，pydantic-settings 按 JSON 解析 list 类型的环境变量
CHUNK_SEPARATORS=["\n\n", "\n", "。", "！", "？", ". ", " ", ""]
TEXT_EMBED_MODEL=BAAI/bge-m3
CLIP_MODEL_NAME=OFA-Sys/chinese-clip-vit-base-patch16
# 两阶段 rerank 总开关。false 时回退到单阶段 RRF 融合排序（不加载/不调用
# cross-encoder 模型），用作模型本身出问题（OOM、权重损坏、GPU 异常）时的
# 应急开关。
RERANKER_ENABLED=false
# 可替换为更轻量的模型以提升 RPS（这个服务是纯 GPU 算力瓶颈，见
# docs/concurrency-benchmark.md，模型越小单次 rerank 越快）；替换前需按
# docs/reranker-model-options.md 的验证清单先跑质量/速度对比，未验证前
# 不要直接切默认值：
#   BAAI/bge-reranker-base    BAAI/bge-reranker-v2-m3                     约 278M，同厂商同用法，
#                                                  质量比当前版本有差距
#   Alibaba-NLP/gte-multilingual-reranker-base     约 306M，官方 benchmark
#                                                  质量持平，但 FlagReranker
#                                                  加载兼容性未验证
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_CANDIDATE_K=30
# cross-encoder 推理精度，bf16（默认）或 fp16。bf16 需要 Ampere 及以上架构 GPU
# （或较新 CPU）才有硬件加速，跑在不支持的硬件上会报错或退化得很慢——部署到旧卡
# 上时手动改回 fp16。
RERANKER_DTYPE=bf16
OCR_LANG=ch
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=600
WATCH_RECONCILE_INTERVAL_SECONDS=3600
# POST /directories/index 允许索引的根目录白名单（本服务 v1 无鉴权，仅内网访问，
# 需要这道限制避免任意路径被索引）。JSON 数组字符串，pydantic-settings 按 JSON
# 解析 list 类型的环境变量，同 CHUNK_SEPARATORS。留空（默认）表示仅允许索引
# DATA_DIR 之下的路径；显式配置后以此为准，不再回退到 DATA_DIR。
ALLOWED_INDEX_ROOTS=[]
# api 和 worker 共用的日志级别（DEBUG/INFO/WARNING/ERROR）。默认 INFO 足够看到
# 模型加载进度（"loading BGE-M3..." / "BGE-M3 loaded" 等阶段性日志）；排查问题
# 时可临时调成 DEBUG。
LOG_LEVEL=INFO
